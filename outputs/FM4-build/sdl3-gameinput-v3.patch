@@ -69,6 +80,7 @@ bool SDL_InitGameInput(IGameInput **ppGameInput)
         g_pGameInput = pGameInput;
 #endif
     }
+#endif // GAMEINPUT_API_VERSION >= 3
     ++g_nGameInputRefCount;
 
     if (ppGameInput) {
