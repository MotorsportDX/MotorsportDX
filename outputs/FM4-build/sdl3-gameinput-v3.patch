--- a/src/core/windows/SDL_gameinput.cpp
+++ b/src/core/windows/SDL_gameinput.cpp
@@ -32,6 +32,17 @@ static int g_nGameInputRefCount;
 
 bool SDL_InitGameInput(IGameInput **ppGameInput)
 {
+#if GAMEINPUT_API_VERSION >= 3
+    // GameInput v3: the GameInput package's loader (its GameInput.cpp, built in) loads the newest
+    // GameInput runtime and creates the v3 interface; a missing or older runtime fails here.
+    if (g_nGameInputRefCount == 0) {
+        HRESULT hr = GameInputInitialize(IID_IGameInput, (void **)&g_pGameInput);
+        if (FAILED(hr)) {
+            g_pGameInput = NULL;
+            return WIN_SetErrorFromHRESULT("GameInputInitialize failed", hr);
+        }
+    }
